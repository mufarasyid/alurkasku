# Application
APP_ENV=development
APP_PORT=8080
APP_VERSION=1.0.0
APP_READ_TIMEOUT=10s
APP_WRITE_TIMEOUT=10s
APP_IDLE_TIMEOUT=120s

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alurkasku
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300s

# Security / JWT
JWT_SECRET=change-me-in-production-super-secret-key
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=720h

# Logger
LOG_LEVEL=info
LOG_PRETTY=false